# Copy to scanner/.env and fill in. Never commit .env (it's gitignored).
#
# From https://developer.ebay.com → My Account → Application Keys.
# There are TWO keysets per app: Sandbox and Production. They are not interchangeable.
#   App ID (Client ID)  → EBAY_CLIENT_ID
#   Cert ID (Client Secret) → EBAY_CLIENT_SECRET
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# sandbox | production.  Sandbox data is thin and fake — use it to prove the
# plumbing works, then switch to production (open to all developers for the
# Browse API, 5,000 calls/day).
EBAY_ENV=production

# Which eBay site's listings + currency: EBAY_IE, EBAY_GB, EBAY_US, EBAY_DE, ...
EBAY_MARKETPLACE=EBAY_IE
